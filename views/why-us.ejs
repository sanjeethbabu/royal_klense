<%- include('partials/header') %>

  <section class="section page-hero">
    <div class="container" style="text-align:center">
      <span class="section-tag">FAQ & Feedback</span>
      <h1 class="section-title">Frequently Asked Questions</h1>
      <p class="section-desc" style="max-width:650px;margin:0 auto">Find quick answers about our products, ordering, and support — or share your feedback with us.</p>
    </div>
  </section>

  <section class="section faq" style="padding-top:0">
    <div class="container">
      <div class="section-header reveal" data-delay="0">
        <span class="section-tag">Common Questions</span>
        <h2 class="section-title">Everything You Need to Know</h2>
      </div>
      <div class="faq-list" id="faqList">
        <div class="faq-item reveal" data-delay="0">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>What products does Royal Klense manufacture?</span>
            <i class="fas fa-chevron-down faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>We manufacture over 300 cleaning and hygiene products across 12 categories — including industrial cleansers, dishwash liquids, disinfectant surface cleaners, handwash, room fresheners, and more for hotels, hospitals, industries, and institutions.</p>
          </div>
        </div>
        <div class="faq-item reveal" data-delay="50">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Do you offer custom formulations?</span>
            <i class="fas fa-chevron-down faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes. Our R&D team develops tailored formulations and cleaning programs to match specific industry requirements and application needs.</p>
          </div>
        </div>
        <div class="faq-item reveal" data-delay="100">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>What is the minimum order quantity (MOQ)?</span>
            <i class="fas fa-chevron-down faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>MOQs vary by product and packaging. Contact our sales team with your requirements and we will share the applicable minimum order quantity for your selection.</p>
          </div>
        </div>
        <div class="faq-item reveal" data-delay="150">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Do you supply across India?</span>
            <i class="fas fa-chevron-down faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Yes, we have a pan-India distribution network ensuring timely delivery to all locations. For specific delivery timelines, reach out with your pincode.</p>
          </div>
        </div>
        <div class="faq-item reveal" data-delay="200">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>Are your products safe and certified?</span>
            <i class="fas fa-chevron-down faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Absolutely. Our manufacturing is ISO 9001:2015 and ISO 14001:2015 certified with GMP-compliant processes, and every batch is tested in our in-house laboratory for quality and safety.</p>
          </div>
        </div>
        <div class="faq-item reveal" data-delay="250">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>How can I request a quote?</span>
            <i class="fas fa-chevron-down faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Click the "Enquire Quote" button in the menu, or contact us directly via phone, WhatsApp, or email. Our team responds within 24 hours.</p>
          </div>
        </div>
        <div class="faq-item reveal" data-delay="300">
          <button class="faq-question" type="button" aria-expanded="false">
            <span>How do I share feedback about a product or service?</span>
            <i class="fas fa-chevron-down faq-icon"></i>
          </button>
          <div class="faq-answer">
            <p>Use the feedback form below — tell us about your experience, and we will use it to continuously improve our products and service.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section feedback" style="padding-top:0">
    <div class="container">
      <div class="section-header reveal" data-delay="0">
        <span class="section-tag">Your Opinion Matters</span>
        <h2 class="section-title">Share Your Feedback</h2>
        <p class="section-desc">We value your input. Let us know how we can serve you better.</p>
      </div>
      <div class="feedback-card reveal" data-delay="100">
        <form id="feedbackForm" onsubmit="handleFeedback(event)">
          <div class="form-row">
            <div class="form-group">
              <label for="fb_name">Full Name *</label>
              <input type="text" id="fb_name" required placeholder="Your full name">
            </div>
            <div class="form-group">
              <label for="fb_email">Email Address *</label>
              <input type="email" id="fb_email" required placeholder="your@email.com">
            </div>
          </div>
          <div class="form-group">
            <label for="fb_rating">Rating</label>
            <select id="fb_rating">
              <option value="Excellent">Excellent</option>
              <option value="Good">Good</option>
              <option value="Average">Average</option>
              <option value="Poor">Poor</option>
            </select>
          </div>
          <div class="form-group">
            <label for="fb_message">Feedback *</label>
            <textarea id="fb_message" required placeholder="Share your experience, suggestions, or concerns..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">
            <i class="fas fa-paper-plane"></i> Submit Feedback
          </button>
        </form>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
