<%- include('partials/header') %>

  <main class="products-page">
    <div class="products-hero">
      <div class="products-hero-bg"></div>
      <div class="products-hero-content">
        <div class="latest-updates-wrap">
          <button class="latest-updates-btn" id="latestUpdatesBtn">
            <span class="latest-updates-btn-dot"></span>
            Click for Latest Updates
          </button>
        </div>
        <h1 class="products-hero-title">Explore Our <span>Products</span></h1>
        <p class="products-hero-subtitle">Premium cleaning solutions for every space</p>
      </div>
    </div>

    <div class="products-sticky-bar" id="productsStickyBar">
      <div class="products-sticky-inner">
        <div class="filter-tags" id="filterTags">
          <div class="filter-slider" id="filterSlider"></div>
          <button class="filter-tag active" data-filter="cleansers">Cleansers</button>
          <button class="filter-tag" data-filter="freshners">Freshners</button>
        </div>
      </div>
    </div>

    <div class="products-wrapper">
      <div id="productsCatalog" class="products-catalog"></div>
    </div>
  </main>

  <div class="pkg-popup-overlay" id="pkgPopupOverlay">
    <div class="pkg-popup" id="pkgPopup">
      <button class="pkg-popup-close" id="pkgPopupClose" type="button" aria-label="Close">
        <span class="close-icon"><i class="fas fa-times"></i></span>
      </button>
      <div class="pkg-popup-icon"><i class="fas fa-box-open"></i></div>
      <span class="pkg-popup-title">See What's New </span>

      <ul class="pkg-popup-list">
        <li>Cleaning products are available in <strong>5-litre</strong> and <strong>500-ml</strong> packages.</li>
        <li>Air fresheners are available in <strong>5-litre</strong> and <strong>500-ml</strong> packages.</li>
        <li>Toilet bowl cleansers are available in <strong>5-litre</strong> and <strong>500-ml</strong> packages.</li>
      </ul>
    </div>
  </div>

  <%- include('partials/footer') %>